# Copie este arquivo para ".env" e preencha. O .env fica FORA do git (tem segredos).
# Caminhos relativos são relativos à pasta do projeto.

# Pasta dos dados (banco, imagens já borradas, backups, logs). Fora de app/ e de static/.
DATA_DIR=./data
# Banco: SQLite por padrão. Para PostgreSQL, troque só esta linha (ex.: postgresql://usuario:senha@servidor/epi).
DATABASE_URL=sqlite:///./data/db/epi.sqlite3

# Chave que assina o cookie de login (Etapa 2.3). Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
# Primeiro administrador, criado no primeiro uso; a troca de senha é obrigatória no primeiro acesso (F2-D9).
ADMIN_LOGIN_INICIAL=admin
ADMIN_SENHA_INICIAL=troque-no-primeiro-acesso

# Câmeras IP: usuário e senha do RTSP ficam aqui, nunca no banco (F2-D10).
RTSP_USUARIO=
RTSP_SENHA=

# Alerta opcional pelo Telegram (RD09). Única exceção ao "nada vai para fora do computador".
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Só para o treino no Colab/Kaggle (Fase 1). Não é usada pelo sistema web.
ROBOFLOW_API_KEY=
